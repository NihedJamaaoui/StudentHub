<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_message"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_subjects"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subjects_placeholder"
            android:layout_marginBottom="20dp"/>

        <!-- Mes tâches -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_tasks"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tasks_placeholder"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upcoming_deadlines"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/deadlines_placeholder"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnMatieres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_subjects"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnTaches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_tasks"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnEcheances"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upcoming_deadlines"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnProfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_profile"/>
    </LinearLayout>
</ScrollView>