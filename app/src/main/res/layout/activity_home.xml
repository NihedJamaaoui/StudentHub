<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Bandeau d'accueil -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenue !"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <!-- Mes matières -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mes matières"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune matière pour le moment"
            android:layout_marginBottom="20dp"/>

        <!-- Mes tâches -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mes tâches"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune tâche en cours"
            android:layout_marginBottom="20dp"/>

        <!-- Prochaines échéances -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prochaines échéances"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune échéance à venir"
            android:layout_marginBottom="24dp"/>

        <!-- Navigation -->
        <Button
            android:id="@+id/btnMatieres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mes matières"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnTaches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mes tâches"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnEcheances"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prochaines échéances"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnProfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mon profil"/>
    </LinearLayout>
</ScrollView>